# --- Ruko configuration ---
# All values are optional. Without them Ruko runs in demo/mock mode and says so clearly.

# 32-byte key (64 hex chars) used to encrypt contact names and phone numbers at rest.
# If unset in development, a key is generated in .data/secret.key. REQUIRED in production.
RUKO_ENCRYPTION_KEY=

# Storage. Required on Vercel (its filesystem is read-only). Without these, a local file in .data/ is used.
# Connecting Upstash Redis from the Vercel Marketplace sets these automatically
# (it may name them KV_REST_API_URL / KV_REST_API_TOKEN instead — both work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL used in alert messages for the acknowledgement link.
RUKO_PUBLIC_URL=http://localhost:3000

# SMS alerts via Twilio. When all three are set, alerts are really sent.
# When missing, the mock provider records alerts in a demo outbox and the UI says "not actually sent".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
